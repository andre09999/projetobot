{
  "name": "telegram-bot-api",
  "version": "1.0.0",
  "description": "API para autenticação, mensageria e automações integradas ao Telegram.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "db:reset": "sequelize-cli db:migrate:undo:all && npm run db:setup",
    "test": "node --test"
  },
  "keywords": ["telegram", "bot", "automation", "express", "sequelize"],
  "author": "André Luis Ribeiro de Souza",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^0.23.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^9.0.0",
    "dotenv-safe": "^8.2.0",
    "express": "^4.17.1",
    "faunadb": "^4.8.0",
    "firebase": "^10.5.0",
    "jsonwebtoken": "^8.5.1",
    "mysql": "^2.18.1",
    "mysql2": "^2.3.3",
    "node-fetch": "^3.3.2",
    "node-telegram-bot-api": "^0.63.0",
    "pg": "^8.11.3",
    "sequelize": "^6.6.2",
    "socket.io": "^4.3.1",
    "socket.io-client": "^4.3.1",
    "telegraf": "^4.15.0",
    "telegram-node-bot": "^4.0.5"
  },
  "devDependencies": {
    "nodemon": "2.0.15",
    "sequelize-cli": "^6.6.1"
  }
}
